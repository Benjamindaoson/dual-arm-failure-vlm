    "premature_release",
    "retention_failure",
    "slip",
    "sub_mm_misalignment"
  ],
  "training_gates": {
    "run_sft_only_after_base_eval": true,
    "run_rl_only_after_sft_eval": true,
    "run_gspo_only_if_rl_signal_exists": true
  }
}
